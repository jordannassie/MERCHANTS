# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site URL ────────────────────────────────────────────────────────────────
# Must match Supabase Auth redirect URL configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Edge Function Secrets (set via Supabase CLI, not here) ──────────────────
# supabase secrets set MERCHANT_RADAR_CRON_SECRET=<strong-random-32-char-string>
# supabase secrets set ANTHROPIC_API_KEY=<your-key>     # optional, Phase 4 only
